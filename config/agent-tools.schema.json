{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["id", "displayName", "aliases", "adapter"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "displayName": { "type": "string", "minLength": 1 },
      "enabled": { "type": "boolean" },
      "aliases": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "minItems": 1,
        "uniqueItems": true
      },
      "adapter": { "type": "string", "enum": ["directory-skills"] },
      "global": {
        "type": "object",
        "required": ["env", "defaultHome", "skillsPath"],
        "properties": {
          "env": { "type": "string", "minLength": 1 },
          "defaultHome": { "type": "string", "pattern": "^~/" },
          "skillsPath": { "type": "string" }
        }
      },
      "project": {
        "type": "object",
        "required": ["folder", "skillsPath"],
        "properties": {
          "folder": { "type": "string", "pattern": "^\\.[a-z]" },
          "skillsPath": { "type": "string" }
        }
      }
    }
  }
}
